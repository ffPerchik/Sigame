# Скопируй в .env и заполни. Получи токен у @BotFather, узнай свой user_id у @userinfobot.
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
HOST_ID=123456789
# Ключ активации задаётся в quest/stages.yaml (entry_code), а не в .env.
# Username бота (для QR deep-ссылок). Без @.
BOT_USERNAME=my_quest_bot
# Прокси, если api.telegram.org заблокирован (Россия). Пусто = напрямую.
# Примеры:  http://1.2.3.4:8080   socks5://user:pass@1.2.3.4:1080
PROXY=
# Куда складывать БД и файл квеста (по умолчанию — рядом со скриптами).
DB_PATH=
QUEST_FILE=
# Писать ведущему о каждом продвижении игрока (1/0).
NOTIFY_HOST=1
# 1 = не слать ведущему в Telegram, писать в консоль; ручные апрувы проходят сами.
# Нужно, чтобы тестировать квест с того же аккаунта, что HOST_ID.
HOST_CONSOLE=0
